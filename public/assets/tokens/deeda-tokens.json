  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Inter",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "heading": {
      "$type": "fontFamily",
      "$value": [
        "Montserrat",
        "Inter",
        "system-ui",
        "sans-serif"
      ]
    },
    "arabic": {
      "$type": "fontFamily",
      "$value": [
        "Noto Kufi Arabic",
        "SF Arabic",
        "Geeza Pro",
        "Noto Sans Arabic",
        "sans-serif"
      ]
    }
  },
  "type": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "15px",
        "lineHeight": 1.6,
        "fontWeight": 400
      }
    },
    "body-arabic": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.arabic}",
        "fontSize": "16px",
        "lineHeight": 1.8,
        "fontWeight": 400
      }
    },
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.heading}",
        "fontSize": "clamp(44px,5.4vw,66px)",
        "lineHeight": 1,
        "fontWeight": 800,
        "letterSpacing": "-0.04em"
      }
    },
    "page-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.heading}",
        "fontSize": "clamp(28px,2.9vw,38px)",
